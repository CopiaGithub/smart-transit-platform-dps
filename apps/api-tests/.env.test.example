# Copy to .env.test (gitignored) and fill in.
#
# The API's committed appsettings.json points DefaultConnection at a SHARED remote
# dev SQL Server (4.240.53.172 / transit_display_platform_dev). Running the API
# locally does NOT make the database local — rows this suite creates land on that
# shared server and, because deletes are soft, stay there forever.
#
# So writes are OFF by default. Point the API at your own database first, then set
# ALLOW_WRITES=1.

# No trailing /api — every route in the suite is written as /api/Xxx.
# The `https` launch profile listens here; UseHttpsRedirection() is unconditional.
API_BASE_URL=https://localhost:7074

# Seeded accounts are EMP001..EMP008. Password comes from the API's
# Seed:AdminPassword (user-secrets / SEED__ADMINPASSWORD), not from source.
LOGIN_USERNAME=EMP001
LOGIN_PASSWORD=DpsSeed@2026!tmp

# 1 = allow the create/patch/delete suites to run. See the warning above.
ALLOW_WRITES=0
