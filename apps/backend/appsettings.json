{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "School": {
    "TimeZoneId": "India Standard Time"
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
    "JwtSettings": {
    "SecretKey": "",
    "Issuer": "transit-display-platform",
    "Audience": "transit-display-platform-clients",
    "AccessTokenExpiryMinutes": 60
  },
  "AllowedHosts": "*"
}
